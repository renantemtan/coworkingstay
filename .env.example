# Site Base URL
NEXT_PUBLIC_SITE_URL=https://coworkingstay.com

# PostgreSQL Database (Docker VPS or local PostgreSQL)
POSTGRES_DB=coworkingstay
POSTGRES_USER=coworkingstay
POSTGRES_PASSWORD=replace_with_strong_password
DATABASE_URL=postgresql://coworkingstay:replace_with_strong_password@localhost:5432/coworkingstay

# GoDaddy Professional Email Pro Light (SMTP)
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=worknwave@coworkingstay.com
SMTP_PASS=replace_with_mailbox_password
CONTACT_FROM_EMAIL="CoWorkingStay <worknwave@coworkingstay.com>"
CONTACT_RECEIVER_EMAIL=worknwave@coworkingstay.com

# Optional Fallback Email / Webhook Channels
RESEND_API_KEY=
LEAD_WEBHOOK_URL=

# Optional Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
